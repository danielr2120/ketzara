# Conexión a PostgreSQL (usa los mismos datos del .env de la raíz)
DATABASE_URL=postgresql+psycopg://ketzara:cambia-esta-clave@localhost:5433/ketzara
# Opcional: base de datos para pruebas automáticas
TEST_DATABASE_URL=postgresql+psycopg://ketzara:cambia-esta-clave@localhost:5433/ketzara_test

# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=http://localhost:5173

# Zona horaria usada para "hoy" y "este mes"
APP_TIMEZONE=America/Bogota

# Acceso a la administración (los clientes no lo necesitan para /pedir ni /seguimiento)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave
# Texto largo y aleatorio para firmar las sesiones, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET=
